# User-selected administrators. Local deployment example only, not active config.
# Merge these two settings into the approved service environment during rollout.
# Do not replace the existing environment or its Access/DB settings with this file.
BILGE_DEFTER_ADMIN_EMAILS=turgut.urer@gmail.com,sevdilurer@gmail.com
BILGE_DEFTER_ORIGIN=https://defter.bilgearena.com
# Application approval cap; Cloudflare must separately allow only the class list.
BILGE_DEFTER_MAX_STUDENTS=48
# Students are added manually by the two administrators, not by public signup.
BILGE_DEFTER_REGISTRATION_MODE=invitation
