SELECT ?item (SAMPLE(?ta98) AS ?TA98) (SAMPLE(?ta2) AS ?TA2) (SAMPLE(?tr) AS ?TR) (SAMPLE(?en) AS ?EN) (SAMPLE(?la) AS ?LA) (GROUP_CONCAT(DISTINCT ?trAlt; separator="|") AS ?TRALT) (GROUP_CONCAT(DISTINCT ?enAlt; separator="|") AS ?ENALT) WHERE { ?item wdt:P1323 ?ta98 . FILTER(STRSTARTS(?ta98, "A04")) ?item rdfs:label ?en FILTER(LANG(?en)="en") OPTIONAL{?item wdt:P7173 ?ta2} OPTIONAL{?item rdfs:label ?tr FILTER(LANG(?tr)="tr")} OPTIONAL{?item rdfs:label ?la FILTER(LANG(?la)="la")} OPTIONAL{?item skos:altLabel ?trAlt FILTER(LANG(?trAlt)="tr")} OPTIONAL{?item skos:altLabel ?enAlt FILTER(LANG(?enAlt)="en")} } GROUP BY ?item
